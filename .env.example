# ===== Backend configuration =====
# PostgreSQL connection string (update user/password/host/port to match your environment)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/career_track?schema=public"

# Server
PORT=4000
NODE_ENV=development

# JWT secrets
JWT_SECRET="change-me"
JWT_EXPIRES_IN="7d"

# Frontend origin (CORS locked to this)
FRONTEND_URL="http://localhost:5173"

# Cookie settings
COOKIE_SECURE=false

# Storage
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="uploads"
STORAGE_BASE_URL="http://localhost:4000"
