# ===== Backend environment variables =====
# Copy to .env and adjust for your environment.
# Never commit real credentials. Use placeholders here only.

# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/career_track?schema=public"

# Server
PORT=4000
NODE_ENV=development

# JWT secrets - change to a strong value in production
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"

# Frontend origin (CORS is locked to this origin)
FRONTEND_URL="http://localhost:5179"

# Cookie settings
# Set COOKIE_SECURE=true in production (HTTPS)
COOKIE_SECURE=false

# Storage
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="uploads"
STORAGE_BASE_URL="http://localhost:4000"
