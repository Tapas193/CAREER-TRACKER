# ===== Backend environment variables =====
# Copy to .env and adjust for your environment.
# Never commit real credentials. Use placeholders here only.

# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/career_track?schema=public"

# Server
PORT=4000
# Set NODE_ENV=production on the deployed backend. This enables the
# SameSite=None auth cookie needed for the split-origin frontend.
NODE_ENV=development

# JWT secrets - change to a strong value in production
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"

# Frontend origin (CORS is locked to this origin, and SSO callbacks redirect here).
# Production MUST point to the deployed frontend, e.g. FRONTEND_URL="https://career-track.vercel.app"
FRONTEND_URL="http://localhost:5179"

# Cookie settings
# Set COOKIE_SECURE=true in production (HTTPS)
COOKIE_SECURE=false

# Storage
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="uploads"
STORAGE_BASE_URL="http://localhost:4000"

# ===== University SSO (OIDC) — optional =====
# SSO is DISABLED until SSO_PROVIDER and SSO_ISSUER are set.
# SSO_PROVIDER=""
# SSO_CLIENT_ID=""
# SSO_CLIENT_SECRET=""
# SSO_ISSUER=""                    # https://your-idp.example.com
# SSO_REDIRECT_URI=""              # optional; derived from the request when empty
# SSO_SCOPE="openid email profile"
# SSO_ALLOWED_DOMAIN=""            # optional, e.g. university.edu
# SSO_ADMIN_EMAILS=""              # optional, comma-separated emails -> ADMIN

# ===== Vercel production =====
# These must be set in the Vercel dashboard (backend project), not in code:
#  - DATABASE_URL            hosted Postgres connection string
#  - NODE_ENV=production
#  - JWT_SECRET              strong, stable secret
#  - JWT_EXPIRES_IN=7d
#  - FRONTEND_URL            https://<deployed-frontend-domain>
#  - COOKIE_SECURE=true
#  - PRISMA_SKIP_POSTINSTALL_GENERATE=true
#      Disables @prisma/client's auto postinstall generation, which Prisma
#      aborts on Vercel ("Prisma has detected that this project was built on
#      Vercel..."). Generation is done explicitly by the buildCommand instead.
#  - VITE_API_URL is a FRONTEND (Vercel frontend project) variable:
#      https://career-tracker-fsov.vercel.app  (backend origin, no trailing slash)
