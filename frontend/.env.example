# Frontend environment variables (Vite)
# Copy to .env.local and adjust for your environment.
# Only VITE_ prefixed variables are exposed to the browser. Never put secrets here.

# Base URL of the backend API.
# Leave empty ("") to use the Vite dev proxy (/api -> http://localhost:4000).
# PRODUCTION: set this in the Vercel frontend project (Settings -> Environment
# Variables -> Production) to the backend origin, then rebuild + redeploy the
# frontend (Vite variables are baked in at build time):
VITE_API_URL=https://career-tracker-fsov.vercel.app