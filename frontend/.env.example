# Frontend environment variables (Vite)
# Copy to .env.local and adjust for your environment.
# Only VITE_ prefixed variables are exposed to the browser. Never put secrets here.

# Base URL of the backend API.
# Leave empty ("") to use the Vite dev proxy (/api -> http://localhost:4000).
# In production, set this to the backend's public origin, e.g. https://api.example.com
VITE_API_URL=
